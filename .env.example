APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8667

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-server-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8667,http://127.0.0.1:8667,https://your-domain.com
DJANGO_CSRF_COOKIE_NAME=autocert_m_csrftoken
DJANGO_SESSION_COOKIE_NAME=autocert_m_sessionid
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SESSION_COOKIE_SECURE=0

POSTGRES_DB=newlabauto
POSTGRES_USER=erema
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

PDF_CONVERTER_URL=http://converter:3000
PDF_CONVERTER_TIMEOUT=120

CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOW_CREDENTIALS=1
